<task id="t6" name="Gerar etiqueta e enviar rastreio"><incoming>f6</incoming><outgoing>f8</outgoing></task>
<task id="t7" name="Verificar estoque mínimo"><incoming>f7</incoming><incoming>f8</incoming><outgoing>f9</outgoing></task>
<exclusiveGateway id="g2" name="Estoque baixo?"><incoming>f9</incoming><outgoing>f10</outgoing><outgoing>f11</outgoing></exclusiveGateway>
<task id="t8" name="Alertar reposição no WhatsApp"><incoming>f10</incoming><outgoing>f12</outgoing></task>
<endEvent id="e1" name="Fim"><incoming>f12</incoming></endEvent>
<endEvent id="e2" name="Fim"><incoming>f11</incoming></endEvent>
