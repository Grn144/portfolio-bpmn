<task id="t3" name="Baixar estoque em todos os canais"><incoming>f2</incoming><outgoing>f3</outgoing></task>
<exclusiveGateway id="g1" name="Venda online?"><incoming>f3</incoming><outgoing>f4</outgoing><outgoing>f5</outgoing></exclusiveGateway>
