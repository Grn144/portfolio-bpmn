<task id="t7" name="Enviar documentos faltantes"><incoming>f6</incoming><outgoing>f7</outgoing></task>
<task id="t4" name="Analista recebe documentos"><incoming>f5</incoming><incoming>f7</incoming><outgoing>f8</outgoing></task>
<task id="t5" name="Realizar fechamento contábil"><incoming>f8</incoming><outgoing>f9</outgoing></task>
<endEvent id="e1" name="Fim"><incoming>f9</incoming></endEvent>
