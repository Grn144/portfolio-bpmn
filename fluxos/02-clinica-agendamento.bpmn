<task id="t5" name="Comparecer à consulta"><incoming>f5</incoming><outgoing>f7</outgoing></task>
<task id="t7" name="Enviar pesquisa de satisfação"><incoming>f7</incoming><outgoing>f8</outgoing></task>
<endEvent id="e1" name="Fim"><incoming>f8</incoming></endEvent>
<task id="t6" name="Liberar horário"><incoming>f6</incoming><outgoing>f9</outgoing></task>
<task id="t8" name="Oferecer à lista de espera"><incoming>f9</incoming><outgoing>f10</outgoing></task>
<endEvent id="e2" name="Fim"><incoming>f10</incoming></endEvent>
